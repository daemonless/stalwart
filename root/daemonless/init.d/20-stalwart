#!/bin/sh
# pkg variant seeds the packaged config.toml (+ IPv4/IPv6 http listener). The
# 0.16 binary variant has no file-based listeners, so it ships nothing and boots
# into bootstrap mode (mirrors the FreeBSD mail/stalwart 0.16 port).
set -e

CONF=/config/config.toml

if [ ! -f "$CONF" ] && [ -f /usr/local/etc/stalwart/config.toml ]; then
    echo "[stalwart] seeding $CONF from packaged default"
    cp /usr/local/etc/stalwart/config.toml "$CONF"
    cat >> "$CONF" <<'EOF'

[server.listener."http"]
protocol = "http"
bind = ["0.0.0.0:8080", "[::]:8080"]
EOF
fi

mkdir -p /config/data /config/logs
chown -R bsd:bsd /config/logs 2>/dev/null || true

# Re-chown only on first run / ownership change (marker in /config); SKIP_CHOWN=false
# forces it. No-op on the binary variant (no stalwart user).
SKIP_CHOWN=${SKIP_CHOWN:-true}
WANT="stalwart:stalwart"
if [ "${SKIP_CHOWN}" = "true" ] && [ "$(cat /config/.chown_done 2>/dev/null)" = "$WANT" ]; then
    :
else
    echo "$WANT" > /config/.chown_done
    chown -R stalwart:stalwart /config 2>/dev/null || true
    chown -R bsd:bsd /config/logs 2>/dev/null || true
fi
