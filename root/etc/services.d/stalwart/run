#!/bin/sh
# Runs as root: FreeBSD has no setcap for the privileged mail ports.
# STALWART_CONFIG is config.toml (pkg/0.15) or config.json (binary/0.16).

export STALWART_PATH=/config

# IPv4 works for both: pkg dual-binds 0.0.0.0; 0.16 gets it via the socat bridge.
s6-ready-when fetch -qo /dev/null http://127.0.0.1:8080/healthz/live

exec /usr/local/bin/stalwart --config "${STALWART_CONFIG:-/config/config.toml}"
