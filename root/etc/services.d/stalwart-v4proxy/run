#!/bin/sh
# 0.16 bootstrap binds [::]:8080 (IPv6-only on FreeBSD). Bridge IPv4 -> [::1] so
# the setup UI / healthcheck are reachable without IPv6.

# Skip for pkg variant (which dual-binds 0.0.0.0 via config.toml) or if ENABLE_V4PROXY=false
if [ -f /usr/local/etc/stalwart/config.toml ] || [ "${ENABLE_V4PROXY:-true}" = "false" ] || [ "${ENABLE_V4PROXY:-true}" = "0" ]; then
    exit 0
fi

exec socat TCP4-LISTEN:8080,fork,reuseaddr TCP6:[::1]:8080
